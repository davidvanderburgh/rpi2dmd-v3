[Unit]
Description=RPI2DMD v3 web interface
After=network.target rpi2dmd-player.service

[Service]
Type=simple
WorkingDirectory=/opt/rpi2dmd-v3/webui
Environment=PYTHONPATH=/opt/rpi2dmd-v3/player
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/rpi2dmd-v3/webui/app.py
# Yield to the player: smooth animations matter more than fast page loads.
# The render loop is asleep most of each frame period, so the web UI gets
# that time; it just never preempts a frame that is due.
Nice=5
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
