[Unit]
Description=RPI2DMD v3 DMD player (renderer/scheduler)
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/opt/rpi2dmd-v3/player
Environment=PYTHONPATH=/opt/rpi2dmd-v3/player
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m rpi2dmd.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
